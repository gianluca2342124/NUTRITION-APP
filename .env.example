# -----------------------------------------------------------------------------
# Web app + API (apps/web/.env.local). Server-only values never reach clients.
# -----------------------------------------------------------------------------

# Supabase project (local: `pnpm db:start`, then `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Used only on the server for catalogue writes, quotas and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site (canonical URLs, sitemap). No domain is assumed to be registered.
PUBLIC_SITE_URL=http://localhost:3000
# Browser origins allowed to call /api/v1 (Expo web in development). Native apps need nothing.
API_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# AI (optional). Without a key, AI endpoints answer 503 "ai_not_configured" and the
# apps fall back to search and manual logging. Every task model is configurable.
ANTHROPIC_API_KEY=
AI_MODEL_VISION=claude-opus-5-5
AI_MODEL_EXTRACTION=claude-sonnet-5-5
AI_MODEL_CLASSIFICATION=claude-haiku-5-5
AI_MODEL_CONVERSATION=claude-opus-5-5
# Thinking depth per task: low | medium | high | xhigh | max
AI_EFFORT_VISION=medium
AI_EFFORT_EXTRACTION=low
AI_EFFORT_CLASSIFICATION=low
AI_EFFORT_CONVERSATION=medium
# Server-side refusal fallback ("default" routing). Set to "off" if your account lacks the beta.
AI_FALLBACKS=default

# Speech-to-text (optional): any OpenAI-compatible /audio/transcriptions endpoint.
# Without it, voice logging falls back to typed input.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Per-user rolling 24 h limits for AI features (cost control).
AI_DAILY_LIMIT_MEAL_PHOTO=25
AI_DAILY_LIMIT_LABEL=25
AI_DAILY_LIMIT_PARSE_MEAL=60
AI_DAILY_LIMIT_TRANSCRIBE=60

# Open Food Facts asks clients to identify themselves: "AppName/Version (contact)".
OFF_USER_AGENT=NutritionPlatform/0.1 (development)
OFF_CACHE_DAYS=30

# -----------------------------------------------------------------------------
# Mobile app (apps/mobile/.env.local). EXPO_PUBLIC_* values are bundled: public only.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Origin serving /api/v1. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Store identifiers (provisional defaults live in packages/config/src/brand.ts).
APP_IOS_BUNDLE_ID=
APP_ANDROID_PACKAGE=
